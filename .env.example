# LiteLLM Proxy - Example Environment File
# Copy to .env and customize. Do NOT commit secrets.

# ---------------------------------------------------------------------------
# Core service configuration
# ---------------------------------------------------------------------------
# Port the host will publish (docker-compose maps ${PORT:-4000} -> container 4000)
PORT=4000

# Master key used by the local proxy for client authentication
# External client API key. With CONFIG_BACKEND=db this is migrated into
# SQLite on first startup and can later be changed in the Admin UI.
LITELLM_MASTER_KEY=sk-local-master

# Whether server responses stream by default (can be overridden per request)
STREAMING_ENABLE=true

# Optional: default reasoning effort for CLI defaults when supported by a model
# Values: none|low|medium|high
REASONING_EFFORT=medium

# ---------------------------------------------------------------------------
# Global upstream defaults
# ---------------------------------------------------------------------------
# Base URL for upstream OpenAI-compatible APIs
OPENAI_BASE_URL=https://agentrouter.org/v1

# Optional upstream network proxy for agentrouter.org / provider APIs.
# Supports http://, https://, socks://, socks4://, socks5://.
# With CONFIG_BACKEND=db, prefer changing this in Admin UI -> 运行配置.
# UPSTREAM_PROXY_URL=socks5://user:pass@host:port

# Token limits / other shared knobs
MAX_TOKENS=8192

# ---------------------------------------------------------------------------
# Node.js Upstream Proxy (REQUIRED)
# ---------------------------------------------------------------------------
# Enable Node.js upstream proxy (required for proper API compatibility)
# The proxy URL is auto-detected:
#   - Docker Compose: http://node-proxy:4000/v1 (separate service)
#   - Local/Single Container: http://127.0.0.1:4000/v1 (subprocess)
NODE_UPSTREAM_PROXY_ENABLE=1

# ---------------------------------------------------------------------------
# Telemetry
# ---------------------------------------------------------------------------
# Enable telemetry collection: 1 to enable, 0 to disable
TELEMETRY_ENABLE=1
# SQLite database path for persisted request logs
TELEMETRY_DB_PATH=data/telemetry.sqlite3

# ---------------------------------------------------------------------------
# Anthropic upstream configuration
# ---------------------------------------------------------------------------
# Base URL for Anthropic upstream API (default: https://agentrouter.org).
# The Anthropic SDK appends /v1/messages internally, so do NOT include /v1.
# ANTHROPIC_BASE_URL=https://agentrouter.org

# ---------------------------------------------------------------------------
# Configuration Storage Backend
# ---------------------------------------------------------------------------
# Storage backend for models, API keys, and admin credentials:
#   db  (default) - SQLite via ConfigStore (manage via Admin UI)
#   env (legacy)  - environment variables / .env file
# CONFIG_BACKEND=db

# SQLite database path for configuration storage (default: data/config.sqlite3)
# CONFIG_DB_PATH=data/config.sqlite3

# ---------------------------------------------------------------------------
# Networking (container runtime)
# ---------------------------------------------------------------------------
# Host bind address (entrypoint defaults to 0.0.0.0). Usually leave as default.
# LITELLM_HOST=0.0.0.0

# ---------------------------------------------------------------------------
# Test-only knobs (used in demos/tests)
# ---------------------------------------------------------------------------
TEST_TIMEOUT=30
TEST_MAX_TOKENS=500

# ---------------------------------------------------------------------------
# Admin Management Panel
# ---------------------------------------------------------------------------
# Access the admin panel at http://localhost:4000/admin/ for Docker Compose,
# or http://localhost:8000/admin/ for source deployment.
# Login is always required. Default credentials are admin/changeme.
#
# NOTE: Models, API Keys, and Admin Credentials are now managed via the
# Admin UI and stored in SQLite (data/config.sqlite3).
# On first startup with CONFIG_BACKEND=db, existing MODEL_* and *_API_KEY*
# variables from a legacy .env are automatically migrated.
#
# For the legacy env-based backend (CONFIG_BACKEND=env), uncomment the
# sections below.

# Admin credentials (for first-time setup; subsequent changes via Admin UI
# are persisted to SQLite when CONFIG_BACKEND=db)
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=changeme

# Optional: JWT secret for admin panel. Defaults to LITELLM_MASTER_KEY.
# ADMIN_JWT_SECRET=change-me-to-a-long-random-secret

# Base URL used by the admin API helper. Docker Compose overrides this to 4000.
# ADMIN_PROXY_BASE_URL=http://127.0.0.1:8000

# ===========================================================================
# Legacy: env-based model & key configuration (CONFIG_BACKEND=env only)
# ===========================================================================
# Uncomment and use these only if you set CONFIG_BACKEND=env.

# Upstream API key. Replace with your real key.
# OPENAI_API_KEY=sk-your-upstream-api-key

# Multiple upstream API keys for load-balanced routing (comma-separated).
# OPENAI_API_KEYS=sk-key1,sk-key2,sk-key3

# Anthropic API key (falls back to OPENAI_API_KEY if not set).
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# Multiple Anthropic API keys for load-balanced routing (comma-separated).
# ANTHROPIC_API_KEYS=sk-ant-key1,sk-ant-key2,sk-ant-key3

# Declare models via MODEL_<KEY>_* variables (keys: alphanumeric/underscore).
# MODEL_DEEPSEEK_UPSTREAM_MODEL=deepseek-v3.2
# MODEL_DEEPSEEK_REASONING_EFFORT=medium
# MODEL_GLM_UPSTREAM_MODEL=glm-4.6
# MODEL_CLAUDE_OPUS_UPSTREAM_MODEL=claude-opus-4-6
